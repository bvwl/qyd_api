# ==========================================
# 应用配置
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=6080
APP_DEBUG=0
APP_WORKERS=1

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API 文档: 1=启用, 0=禁用（生产环境建议禁用）
ENABLE_DOCS=1

# CORS 配置（多个域名用逗号分隔，* 表示允许所有）
# 生产环境建议指定具体域名，如: https://example.com,https://app.example.com
CORS_ORIGINS=*

# ==========================================
# 服务器性能配置
# ==========================================
APP_LIMIT_CONCURRENCY=10000
APP_BACKLOG=4096
APP_TIMEOUT_KEEP_ALIVE=5

# ==========================================
# 数据库配置
# ==========================================
DB_ENGINE=tortoise.backends.mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qyd
DB_PASSWORD=your_password_here
DB_NAME=qyd
DB_MINSIZE=20
DB_MAXSIZE=80
DB_ECHO=0
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=10

# ==========================================
# JWT 配置
# ==========================================
# JWT 密钥（生产环境必须修改为强密码，至少32位）
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
# JWT 加密算法
JWT_ALGORITHM=HS256
# JWT 过期时间（秒），默认24小时
JWT_EXPIRE_TIME=86400

# ==========================================
# 定时任务配置
# ==========================================
# 数据库连接检查间隔（分钟）
DB_CHECK_INTERVAL_MINUTES=30

# 是否启用邮箱状态自动检查: 1=启用, 0=禁用
ENABLE_EMAIL_CHECK=0

# 邮箱状态检查间隔（小时）
EMAIL_CHECK_INTERVAL_HOURS=1

# 是否启用项目统计数据自动同步: 1=启用, 0=禁用
ENABLE_STATS_SYNC=1

# 项目统计数据同步间隔（分钟），默认60分钟
STATS_SYNC_INTERVAL_MINUTES=60

# ==========================================
# 优雅关闭配置
# ==========================================
# 关闭时等待任务完成的时间（秒）
SHUTDOWN_WAIT_SECONDS=0.5

# ==========================================
# Redis 配置
# ==========================================
# Redis 主机地址
REDIS_HOST=127.0.0.1

# Redis 端口
REDIS_PORT=6379

# Redis 密码（如果没有密码则留空）
REDIS_PASSWORD=

# Redis 数据库编号（0-15）
REDIS_DB=0

# Redis 连接池最大连接数
REDIS_MAX_CONNECTIONS=50

# Redis 连接超时时间（秒）
REDIS_TIMEOUT=5

# Redis 键前缀（用于区分不同应用）
REDIS_KEY_PREFIX=qyd:

# 是否启用 Redis: 1=启用, 0=禁用
REDIS_ENABLED=1

# Redis 队列配置
# 每批处理的数据量（建议100-500）
REDIS_QUEUE_BATCH_SIZE=200

# 工作线程数量（建议2-8，根据服务器性能调整）
REDIS_QUEUE_NUM_WORKERS=4

# 缓存过期时间（秒），默认1小时，用于避免重复处理
REDIS_QUEUE_CACHE_EXPIRE=3600
