# 高性能配置示例 - 支持2000+条/秒
# 复制此文件为 .env 并根据实际情况调整

# ==========================================
# Redis队列配置（关键性能参数）
# ==========================================
REDIS_QUEUE_NUM_WORKERS=8          # Worker数量：8个并发处理
REDIS_QUEUE_BATCH_SIZE=300         # 批处理大小：每批300条
REDIS_QUEUE_CACHE_EXPIRE=3600      # 缓存过期时间：1小时

# ==========================================
# 数据库连接池配置（主库 - 写操作）
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=qyd
DB_PASSWORD=your_password
DB_NAME=qyd
DB_MINSIZE=10                      # 最小连接数
DB_MAXSIZE=40                      # 最大连接数（增加到40）
DB_POOL_RECYCLE=3600               # 连接回收时间：1小时
DB_CONNECT_TIMEOUT=10              # 连接超时：10秒

# ==========================================
# 读写分离配置
# ==========================================
DB_READ_WRITE_SPLIT=1              # 启用读写分离

# 从库1配置
DB_SLAVE1_HOST=127.0.0.1
DB_SLAVE1_PORT=3308
DB_SLAVE1_USER=qyd
DB_SLAVE1_PASSWORD=your_password
DB_SLAVE1_NAME=qyd
DB_SLAVE1_MINSIZE=10
DB_SLAVE1_MAXSIZE=40               # 增加到40

# 从库2配置
DB_SLAVE2_HOST=127.0.0.1
DB_SLAVE2_PORT=3309
DB_SLAVE2_USER=qyd
DB_SLAVE2_PASSWORD=your_password
DB_SLAVE2_NAME=qyd
DB_SLAVE2_MINSIZE=10
DB_SLAVE2_MAXSIZE=40               # 增加到40

# ==========================================
# Redis配置
# ==========================================
REDIS_ENABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
REDIS_PASSWORD=redis_fNmAxZ
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100          # 增加到100
REDIS_TIMEOUT=5
REDIS_KEY_PREFIX=qyd:

# ==========================================
# JWT配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400              # 24小时

# ==========================================
# 服务器配置
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=6080
APP_DEBUG=0
APP_WORKERS=4                      # HTTP服务：4个进程

# ==========================================
# 队列处理配置（重要！）
# ==========================================
ENABLE_QUEUE_WORKERS=0             # HTTP服务中禁用队列处理
                                   # 使用独立进程：python start_queue_worker.py

# ==========================================
# CORS配置
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# 性能说明
# ==========================================
# 当前配置预期性能：
# - 理论最大：3200条/秒
# - 实际性能：2500-2700条/秒
# - 满足需求：2000条/秒 ✅
# - 余量：约25%

# ==========================================
# 启动方式
# ==========================================
# 1. HTTP服务（4个进程，不处理队列）：
#    python start.py
#
# 2. 队列处理（1个独立进程，8个workers）：
#    python start_queue_worker.py
#
# 总计资源使用：
# - HTTP进程：4个
# - 队列进程：1个（内部8个workers）
# - 数据库连接：约120个（40主库 + 40从库1 + 40从库2）
# - Redis连接：约100个
