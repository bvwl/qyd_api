# 超高性能配置 - 支持10000+条/秒
# 服务器配置：48核心，128GB内存

# ==========================================
# HTTP服务配置
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=6080
APP_WORKERS=8                    # 8个HTTP进程
APP_DEBUG=0
ENABLE_QUEUE_WORKERS=0           # HTTP服务中禁用队列处理

# ==========================================
# Redis队列配置（关键性能参数）
# ==========================================
REDIS_QUEUE_NUM_WORKERS=12       # 每个队列进程12个workers
REDIS_QUEUE_BATCH_SIZE=500       # 批处理大小：500条
REDIS_QUEUE_CACHE_EXPIRE=7200    # 缓存过期时间：2小时

# ==========================================
# 数据库连接池配置（主库 - 写操作）
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=qyd
DB_PASSWORD=your_password
DB_NAME=qyd
DB_MINSIZE=20                    # 最小连接数
DB_MAXSIZE=80                    # 最大连接数（每个队列进程）
DB_POOL_RECYCLE=3600             # 连接回收时间：1小时
DB_CONNECT_TIMEOUT=10            # 连接超时：10秒
DB_ECHO=0

# ==========================================
# 读写分离配置
# ==========================================
DB_READ_WRITE_SPLIT=1            # 启用读写分离

# 从库1配置
DB_SLAVE1_HOST=127.0.0.1
DB_SLAVE1_PORT=3308
DB_SLAVE1_USER=qyd
DB_SLAVE1_PASSWORD=your_password
DB_SLAVE1_NAME=qyd
DB_SLAVE1_MINSIZE=20
DB_SLAVE1_MAXSIZE=80             # 每个队列进程80个连接

# 从库2配置
DB_SLAVE2_HOST=127.0.0.1
DB_SLAVE2_PORT=3309
DB_SLAVE2_USER=qyd
DB_SLAVE2_PASSWORD=your_password
DB_SLAVE2_NAME=qyd
DB_SLAVE2_MINSIZE=20
DB_SLAVE2_MAXSIZE=80             # 每个队列进程80个连接

# ==========================================
# Redis配置
# ==========================================
REDIS_ENABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
REDIS_PASSWORD=redis_fNmAxZ
REDIS_DB=0
REDIS_MAX_CONNECTIONS=200        # 每个队列进程200个连接
REDIS_TIMEOUT=5
REDIS_KEY_PREFIX=qyd:

# ==========================================
# JWT配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400            # 24小时

# ==========================================
# CORS配置
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# 启动方式
# ==========================================
# 1. HTTP服务（8个进程）：
#    python start.py
#
# 2. 队列处理（3个独立进程，每个12个workers）：
#    python start_queue_worker.py &
#    python start_queue_worker.py &
#    python start_queue_worker.py &
#
# 或使用Supervisor管理（推荐）

