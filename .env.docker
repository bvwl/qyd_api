# ==========================================
# Docker 部署环境变量配置
# ==========================================

# ==========================================
# 数据库配置（外部 MySQL）
# ==========================================
# 如果 MySQL 在宿主机上，使用 host.docker.internal
# 如果 MySQL 在其他服务器上，使用实际 IP 地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=qyd
DB_PASSWORD=your_mysql_password_here
DB_NAME=qyd
DB_MINSIZE=5
DB_MAXSIZE=20

# ==========================================
# Redis 配置（外部 Redis）
# ==========================================
# 如果 Redis 在宿主机上，使用 host.docker.internal
# 如果 Redis 在其他服务器上，使用实际 IP 地址
REDIS_ENABLED=1
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ==========================================
# Redis 队列配置
# ==========================================
REDIS_QUEUE_BATCH_SIZE=200
REDIS_QUEUE_NUM_WORKERS=4
REDIS_QUEUE_CACHE_EXPIRE=3600

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400

# ==========================================
# 服务配置
# ==========================================
DEBUG=0
WORKERS=1

# ==========================================
# CORS 配置
# ==========================================
# 根据实际前端地址配置
CORS_ORIGINS=http://localhost,http://localhost:80,http://your-domain.com

# ==========================================
# 前端配置
# ==========================================
# 前端访问后端 API 的地址
VITE_API_BASE_URL=http://localhost:6080

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90

# ==========================================
# 性能配置（可选）
# ==========================================
# 标准性能配置
# REDIS_QUEUE_BATCH_SIZE=200
# REDIS_QUEUE_NUM_WORKERS=4

# 高性能配置（2000条/秒）
# REDIS_QUEUE_BATCH_SIZE=300
# REDIS_QUEUE_NUM_WORKERS=8

# 超高性能配置（10000+条/秒）
# REDIS_QUEUE_BATCH_SIZE=500
# REDIS_QUEUE_NUM_WORKERS=12
