# ==========================================
# Docker 部署环境变量配置
# ==========================================

# ==========================================
# 数据库配置（外部 MySQL 主从）
# ==========================================
# MySQL 主库配置（用于写操作）
# 如果 MySQL 在宿主机上，使用 host.docker.internal
# 如果 MySQL 在其他服务器上，使用实际 IP 地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=qyd
DB_PASSWORD=your_mysql_password_here
DB_NAME=qyd

# 数据库连接池配置
DB_MINSIZE=5
DB_MAXSIZE=20

# ==========================================
# MySQL 读写分离配置（可选）
# ==========================================
# 是否启用读写分离（1=启用, 0=禁用）
DB_READ_WRITE_SPLIT=0

# 从库1配置（用于读操作）
# 如果不配置，默认使用主库的配置
DB_SLAVE1_HOST=192.168.1.101
DB_SLAVE1_PORT=3306
DB_SLAVE1_USER=qyd
DB_SLAVE1_PASSWORD=your_slave1_password_here
DB_SLAVE1_NAME=qyd
DB_SLAVE1_MINSIZE=5
DB_SLAVE1_MAXSIZE=20

# 从库2配置（用于读操作）
# 如果不配置，默认使用主库的配置
DB_SLAVE2_HOST=192.168.1.102
DB_SLAVE2_PORT=3306
DB_SLAVE2_USER=qyd
DB_SLAVE2_PASSWORD=your_slave2_password_here
DB_SLAVE2_NAME=qyd
DB_SLAVE2_MINSIZE=5
DB_SLAVE2_MAXSIZE=20

# 注意：
# 1. 如果从库账号密码与主库相同，可以不配置 DB_SLAVE*_USER 和 DB_SLAVE*_PASSWORD
# 2. 如果只有一个从库，只配置 DB_SLAVE1_* 即可
# 3. 启用读写分离后，所有读操作会自动路由到从库

# ==========================================
# Redis 配置（Docker 容器内）
# ==========================================
# 注意：Redis 现在运行在 Docker 容器中
# 容器间通过服务名 'redis' 通信
# 只需要配置密码即可
REDIS_ENABLED=1
REDIS_PASSWORD=redis_fNmAxZ
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ==========================================
# Redis 队列配置
# ==========================================
REDIS_QUEUE_BATCH_SIZE=200
REDIS_QUEUE_NUM_WORKERS=4
REDIS_QUEUE_CACHE_EXPIRE=3600

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400

# ==========================================
# 服务配置
# ==========================================
DEBUG=0
WORKERS=1

# ==========================================
# CORS 配置
# ==========================================
# 根据实际前端地址配置
CORS_ORIGINS=http://localhost,http://localhost:80,http://your-domain.com

# ==========================================
# 前端配置
# ==========================================
# 前端访问后端 API 的地址
VITE_API_BASE_URL=http://localhost:6080

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90

# ==========================================
# 性能配置（可选）
# ==========================================
# 标准性能配置
# REDIS_QUEUE_BATCH_SIZE=200
# REDIS_QUEUE_NUM_WORKERS=4

# 高性能配置（2000条/秒）
# REDIS_QUEUE_BATCH_SIZE=300
# REDIS_QUEUE_NUM_WORKERS=8

# 超高性能配置（10000+条/秒）
# REDIS_QUEUE_BATCH_SIZE=500
# REDIS_QUEUE_NUM_WORKERS=12
