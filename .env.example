# ==========================================
# 高并发部署环境变量配置
# 适用场景: 10000+ QPS
# ==========================================

# ==========================================
# 数据库配置（外部 MySQL 主从）
# ==========================================
DB_HOST=192.168.13.6
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=qyd

# 高并发连接池配置（每个容器）
# 5个容器 × 50 × 3(主+2从) = 750 个连接
DB_MINSIZE=10
DB_MAXSIZE=50

# ==========================================
# MySQL 读写分离配置
# ==========================================
DB_READ_WRITE_SPLIT=1

# 从库1配置
DB_SLAVE1_HOST=192.168.13.7
DB_SLAVE1_PORT=3306
DB_SLAVE1_USER=root
DB_SLAVE1_PASSWORD=your_password
DB_SLAVE1_NAME=qyd
DB_SLAVE1_MINSIZE=10
DB_SLAVE1_MAXSIZE=50

# 从库2配置
DB_SLAVE2_HOST=192.168.13.8
DB_SLAVE2_PORT=3306
DB_SLAVE2_USER=root
DB_SLAVE2_PASSWORD=your_password
DB_SLAVE2_NAME=qyd
DB_SLAVE2_MINSIZE=10
DB_SLAVE2_MAXSIZE=50

# ==========================================
# Redis 配置（Docker 容器内）
# ==========================================
REDIS_HOST=192.168.13.6
REDIS_ENABLED=1
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# 5个容器 × 200 = 1000 个连接
REDIS_MAX_CONNECTIONS=200

# ==========================================
# Redis 队列配置（超高性能）
# ==========================================
# 批量大小: 1000（每次处理1000条）
REDIS_QUEUE_BATCH_SIZE=1000

# Worker数量: 16（每个容器16个并发Worker）
# 5个容器 × 16 = 80 个并发Worker
REDIS_QUEUE_NUM_WORKERS=16

# 缓存过期时间: 1小时
REDIS_QUEUE_CACHE_EXPIRE=3600

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400

# ==========================================
# 服务配置
# ==========================================
DEBUG=0

# Docker 中使用多 Worker 提升并发性能
# 注意：日志压缩已移至独立服务，避免多Worker重复执行
WORKERS=4

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=http://192.168.13.6,http://192.168.13.6:80,http://192.168.13.6:8080

# ==========================================
# 前端配置
# ==========================================
VITE_API_BASE_URL=http://192.168.13.6:6080

# ==========================================
# 邮箱检查配置（防封号）
# ==========================================
# 是否启用邮箱状态自动检查
ENABLE_EMAIL_CHECK=0
# 邮箱检查间隔（小时）
EMAIL_CHECK_INTERVAL_HOURS=1
# 邮箱间随机延迟（秒）- 模拟人工操作，避免被识别为机器人
EMAIL_CHECK_DELAY_MIN=2.0
EMAIL_CHECK_DELAY_MAX=5.0
# 批次间随机延迟（秒）- 避免频繁请求触发限流
EMAIL_BATCH_DELAY_MIN=5.0
EMAIL_BATCH_DELAY_MAX=10.0

# ==========================================
# 日志配置
# ==========================================
# 高并发场景使用 WARNING 级别，减少日志写入
LOG_LEVEL=WARNING
LOG_ENABLE_CONSOLE=1
LOG_ENABLE_FILE=1
LOG_CONSOLE_LEVEL=WARNING
LOG_FILE_LEVEL=WARNING
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=9
LOG_MAX_MESSAGE_LENGTH=8192
LOG_MAX_VALUE_LENGTH=1024
API_LOG_SUCCESS_SAMPLE_RATE=0.01
API_LOG_CLIENT_ERROR_SAMPLE_RATE=0.1
API_LOG_SLOW_SECONDS=3
API_LOG_SKIP_PATHS=/health,/api/health
UVICORN_ACCESS_LOG=0
ERROR_TRACKER_MAX_ENTRIES=2048

# 供人工归档清理时参考；压缩服务不会自动批量删除
LOG_RETENTION_DAYS=30

# 日志压缩间隔（小时）- 用于独立日志压缩服务
LOG_COMPRESS_INTERVAL_HOURS=2
LOG_COMPRESS_MIN_AGE_SECONDS=300
LOG_COMPRESS_LEVEL=3

# 启动时是否立即压缩
LOG_COMPRESS_ON_STARTUP=1

# 单实例同时驻留内存的请求上限；更高吞吐请增加实例数
APP_LIMIT_CONCURRENCY=1000
APP_BACKLOG=1024

# ==========================================
# 性能配置说明
# ==========================================
# 当前配置适用于: 5个后端容器 + 5个队列容器 + 1个日志压缩容器
# 
# 预期性能指标:
# - HTTP QPS: 20,000 - 50,000
# - 队列处理: 50,000+ 条/秒
# - 平均响应: < 50ms
# - P99 响应: < 200ms
# 
# 资源使用:
# - 数据库连接: 750 个
# - Redis 连接: 1,000 个
# - CPU 使用: 60-80%
# - 内存使用: 12-16GB
# 
# 扩展方式:
# docker compose -f docker-compose.backend.yml up -d --scale backend-api=5 --scale queue-worker=5
#
# 日志压缩服务:
# - 独立容器运行，避免多Worker重复执行
# - 每2小时自动压缩旧日志
# - 不自动批量删除归档；过期文件按明确路径人工处理
# - 不影响主服务性能
