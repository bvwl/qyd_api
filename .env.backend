# ==========================================
# 后端服务器环境变量配置
# 服务器: 192.168.1.20
# 服务: Backend API + Queue Worker + Redis
# ==========================================

# ==========================================
# 数据库配置（外部 MySQL）
# ==========================================
# MySQL 主库配置
DB_HOST=192.168.1.30
DB_PORT=3306
DB_USER=qyd
DB_PASSWORD=your_mysql_password
DB_NAME=qyd

# 数据库连接池配置
DB_MINSIZE=5
DB_MAXSIZE=20

# ==========================================
# MySQL 读写分离配置（可选）
# ==========================================
# 是否启用读写分离（1=启用, 0=禁用）
DB_READ_WRITE_SPLIT=0

# 从库1配置
DB_SLAVE1_HOST=192.168.1.31
DB_SLAVE1_PORT=3306
DB_SLAVE1_USER=qyd
DB_SLAVE1_PASSWORD=your_mysql_password
DB_SLAVE1_NAME=qyd

# ==========================================
# Redis 配置（外部 Redis 服务器）
# ==========================================
REDIS_ENABLED=1
# Redis 服务器地址（修改为你的 Redis 服务器地址）
REDIS_HOST=192.168.1.20
REDIS_PORT=6379
REDIS_PASSWORD=redis_fNmAxZ
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ==========================================
# Redis 队列配置
# ==========================================
REDIS_QUEUE_BATCH_SIZE=200
REDIS_QUEUE_NUM_WORKERS=4
REDIS_QUEUE_CACHE_EXPIRE=3600

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=86400

# ==========================================
# 服务配置
# ==========================================
DEBUG=0
WORKERS=1

# ==========================================
# CORS 配置（允许前端服务器访问）
# ==========================================
# 前端服务器地址
CORS_ORIGINS=http://192.168.1.10,http://192.168.1.10:80,http://yourdomain.com

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
